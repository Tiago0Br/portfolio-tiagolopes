generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Technology {
  id            Int       @id @default(autoincrement())
  name          String
  description   String
  image         String
  priorityOrder Int?      @map("priority_order")
  projects      Project[]

  @@map("technologies")
}

enum ProjectLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum ProjectType {
  GAME
  FRONTEND
  BACKEND
  FULLSTACK
  MOBILE
  IA
}

model Project {
  id            Int          @id @default(autoincrement())
  name          String
  description   String
  images        String[]
  level         ProjectLevel
  type          ProjectType
  repository    String
  appLink       String?      @map("app_link")
  priorityOrder Int?         @map("priority_order")
  technologies  Technology[]

  @@map("projects")
}
